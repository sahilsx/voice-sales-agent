# Environment Configuration Template (NO REAL SECRETS)

PORT=3000
NODE_ENV=development

# MongoDB Atlas Cloud Database
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@cluster.mongodb.net/voice-sales-agent?retryWrites=true&w=majority

# JWT Authentication Secret — must be 32+ chars, cryptographically random (NOT this placeholder)
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Twilio Telephony Credentials
TWILIO_ACCOUNT_SID=AC_YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_PHONE_NUMBER=+10000000000
# Set to true only if using a paid upgraded Twilio account with Answering Machine Detection (AMD) enabled
ENABLE_TWILIO_AMD=false

# ElevenLabs Text-to-Speech API
ELEVENLABS_API_KEY=sk_YOUR_ELEVENLABS_API_KEY_HERE
ELEVENLABS_VOICE_ID=YOUR_ELEVENLABS_VOICE_ID_HERE

# AI LLM Provider Configuration
# Allowed options: groq | qwen | auto (default: groq)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
OLLAMA_URL=http://localhost:11434/api/chat

# Local Qwen GPU Provider (vLLM OpenAI-Compatible Endpoint)
QWEN_ENABLED=true
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_MODEL=Qwen/Qwen3-4B-Instruct-2507-FP8
QWEN_TIMEOUT_MS=2000

# Redis Queue Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Pipecat Voice Orchestration & Internal Security
# INTERNAL_API_KEY: Generate with: openssl rand -hex 32
INTERNAL_API_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_HEX_KEY
PIPECAT_SERVICE_URL=ws://localhost:8765/ws/twilio
DEEPGRAM_API_KEY=your_deepgram_api_key_here
USE_PIPECAT_FOR_CALLS=false


