# Environment Configuration Template (NO REAL SECRETS)

PORT=3000
NODE_ENV=development

# MongoDB Atlas Cloud Database
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@cluster.mongodb.net/voice-sales-agent?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_super_secret_key_change_in_production

# Twilio Telephony Credentials
TWILIO_ACCOUNT_SID=AC_YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_PHONE_NUMBER=+10000000000

# ElevenLabs Text-to-Speech API
ELEVENLABS_API_KEY=sk_YOUR_ELEVENLABS_API_KEY_HERE
ELEVENLABS_VOICE_ID=YOUR_ELEVENLABS_VOICE_ID_HERE

# AI LLM Provider Keys
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
OLLAMA_URL=http://localhost:11434/api/chat

# Redis Queue Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Pipecat Voice Orchestration & Internal Security
INTERNAL_API_KEY=internal_secret_key_123
PIPECAT_SERVICE_URL=ws://localhost:8765/ws/twilio
DEEPGRAM_API_KEY=your_deepgram_api_key_here
USE_PIPECAT_FOR_CALLS=false


